+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// PS Arabic Translator — draws the Arabic subtitle box on top of the game picture.
+
+package com.metallic.chiaki.translate
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.util.AttributeSet
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.TextView
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/**
+ * Transparent full-screen layer. It never takes focus or touches, so the game keeps every input.
+ * All public methods must be called on the main thread.
+ */
+class SubtitleOverlayView @JvmOverloads constructor(
+	context: Context,
+	attrs: AttributeSet? = null,
+	defStyleAttr: Int = 0
+) : FrameLayout(context, attrs, defStyleAttr)
+{
+	private val subtitleView = TextView(context)
+	private val statusView = TextView(context)
+	private val hideStatusRunnable = Runnable { statusView.animate().alpha(0f).setDuration(400).start() }
+
+	private var placement = TranslationSettings.Placement.COVER_ORIGINAL
+	private var textSizeSp = TranslationSettings.TextSize.MEDIUM.sp
+
+	init
+	{
+		isClickable = false
+		isFocusable = false
+		importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS
+
+		subtitleView.apply {
+			setTextColor(Color.WHITE)
+			typeface = Typeface.create(Typeface.SANS_SERIF, Typeface.BOLD)
+			gravity = Gravity.CENTER
+			textDirection = View.TEXT_DIRECTION_RTL
+			layoutDirection = View.LAYOUT_DIRECTION_RTL
+			setShadowLayer(dp(2f), 0f, dp(1f), Color.BLACK)
+			setLineSpacing(0f, 1.15f)
+			background = GradientDrawable().apply {
+				cornerRadius = dp(10f)
+				setColor(Color.argb(235, 12, 12, 16))
+				setStroke(dp(1f).roundToInt(), Color.argb(90, 255, 255, 255))
+			}
+			val padH = dp(16f).roundToInt()
+			val padV = dp(8f).roundToInt()
+			setPadding(padH, padV, padH, padV)
+			alpha = 0f
+			visibility = View.GONE
+		}
+		addView(subtitleView, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+
+		statusView.apply {
+			setTextColor(Color.WHITE)
+			setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+			textDirection = View.TEXT_DIRECTION_RTL
+			background = GradientDrawable().apply {
+				cornerRadius = dp(8f)
+				setColor(Color.argb(200, 20, 60, 140))
+			}
+			val p = dp(8f).roundToInt()
+			setPadding(p * 2, p, p * 2, p)
+			alpha = 0f
+		}
+		addView(statusView, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT).apply {
+			gravity = Gravity.TOP or Gravity.END
+			val m = dp(20f).roundToInt()
+			setMargins(m, m, m, m)
+		})
+	}
+
+	fun applySettings(settings: TranslationSettings)
+	{
+		placement = settings.placement
+		textSizeSp = settings.textSize.sp
+		subtitleView.setTextSize(TypedValue.COMPLEX_UNIT_SP, textSizeSp)
+	}
+
+	/**
+	 * Shows [text] over [target], a rectangle in this view's own coordinates that covers the
+	 * original subtitle. The box grows upwards from the original's bottom edge so a longer Arabic
+	 * sentence never pushes off the bottom of the screen.
+	 */
+	fun showSubtitle(text: String, target: RectF?)
+	{
+		if(width == 0 || height == 0)
+			return
+		subtitleView.text = text
+
+		val margin = dp(24f)
+		val maxWidth = (width - margin * 2).roundToInt()
+		val minWidth = (width * 0.35f).roundToInt()
+		val lp = subtitleView.layoutParams as LayoutParams
+
+		if(placement == TranslationSettings.Placement.BOTTOM_BAND || target == null)
+		{
+			subtitleView.maxWidth = (width * 0.8f).roundToInt()
+			subtitleView.minWidth = minWidth
+			subtitleView.minHeight = 0
+			lp.gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
+			lp.leftMargin = 0
+			lp.topMargin = 0
+			lp.bottomMargin = (height * 0.06f).roundToInt()
+		}
+		else
+		{
+			val pad = dp(12f)
+			val boxWidth = min(maxWidth, max(minWidth, (target.width() + pad * 2).roundToInt()))
+			subtitleView.minWidth = boxWidth
+			subtitleView.maxWidth = boxWidth
+			val left = (target.centerX() - boxWidth / 2f).coerceIn(margin, width - margin - boxWidth)
+			lp.gravity = Gravity.BOTTOM or Gravity.START
+			lp.leftMargin = left.roundToInt()
+			lp.topMargin = 0
+			lp.bottomMargin = max(dp(8f), height - (target.bottom + pad)).roundToInt()
+			// The box must at least cover the original lines so no English peeks through.
+			subtitleView.minHeight = (target.height() + pad * 2).roundToInt()
+		}
+		subtitleView.layoutParams = lp
+
+		if(subtitleView.visibility != View.VISIBLE)
+		{
+			subtitleView.visibility = View.VISIBLE
+			subtitleView.animate().cancel()
+			subtitleView.alpha = 0f
+			subtitleView.animate().alpha(1f).setDuration(120).start()
+		}
+	}
+
+	fun hideSubtitle()
+	{
+		if(subtitleView.visibility != View.VISIBLE)
+			return
+		subtitleView.animate().cancel()
+		subtitleView.animate().alpha(0f).setDuration(150).withEndAction {
+			subtitleView.visibility = View.GONE
+		}.start()
+	}
+
+	/** Small notice in the corner, e.g. "downloading translation model". */
+	fun showStatus(text: String, sticky: Boolean = false)
+	{
+		removeCallbacks(hideStatusRunnable)
+		statusView.text = text
+		statusView.animate().cancel()
+		statusView.animate().alpha(1f).setDuration(200).start()
+		if(!sticky)
+			postDelayed(hideStatusRunnable, 3500)
+	}
+
+	private fun dp(v: Float) = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, resources.displayMetrics)
+}
