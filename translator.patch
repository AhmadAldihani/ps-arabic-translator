+++ b/android/app/src/main/java/com/metallic/chiaki/regist/PsnLoginActivity.kt
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// PS Arabic Translator — "Sign in with PlayStation" to fetch the PSN Account ID automatically.
+// Same OAuth flow as chiaki-ng's scripts/psn-account-id.py, done inside a WebView.
+
+package com.metallic.chiaki.regist
+
+import android.annotation.SuppressLint
+import android.app.Activity
+import android.content.Intent
+import android.graphics.Color
+import android.net.Uri
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.util.Base64
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.webkit.CookieManager
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.FrameLayout
+import android.widget.ProgressBar
+import android.widget.TextView
+import com.metallic.chiaki.R
+import org.json.JSONObject
+import java.io.IOException
+import java.math.BigInteger
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+
+class PsnLoginActivity : Activity()
+{
+	companion object
+	{
+		const val EXTRA_ACCOUNT_ID = "psn_account_id"
+
+		// Public client of the official PS Remote Play app (same values chiaki-ng ships).
+		private const val CLIENT_ID = "ba495a24-818c-472b-b12d-ff231c1b5745"
+		private const val CLIENT_SECRET = "mvaiZkRsAsI1IBkY"
+		private const val REDIRECT_URI = "https://remoteplay.dl.playstation.net/remoteplay/redirect"
+		private const val TOKEN_URL = "https://auth.api.sonyentertainmentnetwork.com/2.0/oauth/token"
+		private const val LOGIN_URL = "https://auth.api.sonyentertainmentnetwork.com/2.0/oauth/authorize" +
+			"?service_entity=urn:service-entity:psn&response_type=code&client_id=$CLIENT_ID" +
+			"&redirect_uri=$REDIRECT_URI&scope=psn:clientapp&request_locale=en_US&ui=pr&service_logo=ps" +
+			"&layout_type=popup&smcid=remoteplay&prompt=always&PlatformPrivacyWs1=minimal&"
+
+		/** PSN numeric user id → 8 bytes little-endian → Base64, the format Remote Play registration expects. */
+		fun accountIdFromUserId(userId: String): String
+		{
+			val value = BigInteger(userId.trim()).toLong()
+			val bytes = ByteArray(8) { i -> (value ushr (8 * i)).toByte() }
+			return Base64.encodeToString(bytes, Base64.NO_WRAP)
+		}
+	}
+
+	private val mainHandler = Handler(Looper.getMainLooper())
+	private var webView: WebView? = null
+	private lateinit var statusView: TextView
+	private lateinit var progress: ProgressBar
+	private var codeHandled = false
+
+	@SuppressLint("SetJavaScriptEnabled")
+	override fun onCreate(savedInstanceState: Bundle?)
+	{
+		super.onCreate(savedInstanceState)
+		title = getString(R.string.psn_login_title)
+
+		val root = FrameLayout(this)
+		root.setBackgroundColor(Color.WHITE)
+
+		val web = try { WebView(this) } catch(e: Exception) { null }
+
+		progress = ProgressBar(this).apply { visibility = View.GONE }
+		statusView = TextView(this).apply {
+			setTextColor(Color.BLACK)
+			textSize = 18f
+			gravity = Gravity.CENTER
+			setPadding(48, 48, 48, 48)
+			visibility = View.GONE
+		}
+
+		if(web != null)
+		{
+			webView = web
+			root.addView(web, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+			CookieManager.getInstance().removeAllCookies(null)
+			web.settings.javaScriptEnabled = true
+			web.settings.domStorageEnabled = true
+			// Some sign-in pages refuse the embedded-browser marker.
+			web.settings.userAgentString = web.settings.userAgentString.replace("; wv", "")
+			web.webViewClient = object : WebViewClient()
+			{
+				override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean =
+					interceptRedirect(request.url.toString())
+
+				override fun onPageStarted(view: WebView, url: String, favicon: android.graphics.Bitmap?)
+				{
+					if(!interceptRedirect(url))
+						super.onPageStarted(view, url, favicon)
+				}
+			}
+			web.loadUrl(LOGIN_URL)
+		}
+
+		root.addView(statusView, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER))
+		root.addView(progress, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER).apply {
+			topMargin = 200
+		})
+		setContentView(root)
+
+		if(web == null)
+			showError("WebView غير متوفر في هذا الجهاز")
+	}
+
+	override fun onDestroy()
+	{
+		webView?.destroy()
+		webView = null
+		super.onDestroy()
+	}
+
+	@Deprecated("Deprecated in Java")
+	override fun onBackPressed()
+	{
+		val web = webView
+		if(web != null && web.visibility == View.VISIBLE && web.canGoBack())
+			web.goBack()
+		else
+			super.onBackPressed()
+	}
+
+	/** Returns true when [url] is Sony's redirect carrying the auth code (and handles it). */
+	private fun interceptRedirect(url: String): Boolean
+	{
+		if(!url.startsWith(REDIRECT_URI))
+			return false
+		if(codeHandled)
+			return true
+		codeHandled = true
+		val code = Uri.parse(url).getQueryParameter("code")
+		webView?.stopLoading()
+		webView?.visibility = View.GONE
+		if(code.isNullOrEmpty())
+		{
+			showError("no code")
+			return true
+		}
+		statusView.text = getString(R.string.psn_login_working)
+		statusView.visibility = View.VISIBLE
+		progress.visibility = View.VISIBLE
+		Thread { exchangeCode(code) }.start()
+		return true
+	}
+
+	private fun exchangeCode(code: String)
+	{
+		try
+		{
+			val body = "grant_type=authorization_code&code=" + URLEncoder.encode(code, "UTF-8") +
+				"&redirect_uri=" + URLEncoder.encode(REDIRECT_URI, "UTF-8")
+			val tokenJson = JSONObject(http("POST", TOKEN_URL, body))
+			val token = tokenJson.optString("access_token")
+			if(token.isEmpty())
+				throw IOException("access_token missing")
+
+			val infoJson = JSONObject(http("GET", TOKEN_URL + "/" + URLEncoder.encode(token, "UTF-8"), null))
+			val userId = infoJson.optString("user_id")
+			if(userId.isEmpty())
+				throw IOException("user_id missing")
+			val accountId = accountIdFromUserId(userId)
+
+			mainHandler.post {
+				statusView.text = getString(R.string.psn_login_success)
+				progress.visibility = View.GONE
+				setResult(RESULT_OK, Intent().putExtra(EXTRA_ACCOUNT_ID, accountId))
+				mainHandler.postDelayed({ finish() }, 800)
+			}
+		}
+		catch(e: Exception)
+		{
+			mainHandler.post { showError(e.message ?: e.javaClass.simpleName) }
+		}
+	}
+
+	private fun http(method: String, url: String, formBody: String?): String
+	{
+		val conn = URL(url).openConnection() as HttpURLConnection
+		try
+		{
+			conn.requestMethod = method
+			conn.connectTimeout = 15_000
+			conn.readTimeout = 15_000
+			val basic = Base64.encodeToString("$CLIENT_ID:$CLIENT_SECRET".toByteArray(), Base64.NO_WRAP)
+			conn.setRequestProperty("Authorization", "Basic $basic")
+			if(formBody != null)
+			{
+				conn.doOutput = true
+				conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
+				conn.outputStream.use { it.write(formBody.toByteArray(Charsets.US_ASCII)) }
+			}
+			val status = conn.responseCode
+			val stream = if(status in 200..299) conn.inputStream else conn.errorStream
+			val text = stream?.bufferedReader()?.use { it.readText() } ?: ""
+			if(status !in 200..299)
+				throw IOException("HTTP $status")
+			return text
+		}
+		finally
+		{
+			conn.disconnect()
+		}
+	}
+
+	private fun showError(message: String)
+	{
+		progress.visibility = View.GONE
+		statusView.text = getString(R.string.psn_login_failed, message)
+		statusView.visibility = View.VISIBLE
+		setResult(RESULT_CANCELED)
+	}
+}
