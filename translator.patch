diff --git a/android/app/src/test/java/com/metallic/chiaki/translate/SubtitleExtractorTest.kt b/android/app/src/test/java/com/metallic/chiaki/translate/SubtitleExtractorTest.kt
new file mode 100644
index 00000000..c28a43cc
--- /dev/null
+++ b/android/app/src/test/java/com/metallic/chiaki/translate/SubtitleExtractorTest.kt
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+package com.metallic.chiaki.translate
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SubtitleExtractorTest
+{
+	private val w = 1280
+	private val h = 720
+
+	@Test
+	fun picksCentredDialogueAndIgnoresHud()
+	{
+		val lines = listOf(
+			OcrLine("We have to leave before the", Box(400, 600, 880, 630)),
+			OcrLine("storm reaches the village.", Box(420, 636, 860, 666)),
+			OcrLine("Quest: Find Atreus", Box(20, 480, 260, 500)),
+			OcrLine("12:45", Box(600, 450, 680, 470)))
+		val block = SubtitleExtractor.extract(lines, w, h, centeredOnly = true)
+		assertNotNull(block)
+		assertEquals("We have to leave before the storm reaches the village.", block!!.text)
+		assertEquals(Box(400, 600, 880, 666), block.box)
+	}
+
+	@Test
+	fun keepsSpeakersOnSeparateLines()
+	{
+		assertEquals("- Where are you?\n- Right here.",
+			SubtitleExtractor.joinForTranslation(listOf("- Where are you?", "- Right here.")))
+		assertEquals("something new", SubtitleExtractor.joinForTranslation(listOf("some-", "thing new")))
+	}
+
+	@Test
+	fun ocrJitterIsTheSameSubtitle()
+	{
+		val a = SubtitleExtractor.normalize("We have to leave, before the storm!")
+		val b = SubtitleExtractor.normalize("We have to Ieave before the storm")
+		val c = SubtitleExtractor.normalize("Then we go north and find the boat.")
+		assertTrue(SubtitleExtractor.similarity(a, b) > 0.88)
+		assertTrue(SubtitleExtractor.similarity(a, c) < 0.6)
+	}
+
+	@Test
+	fun cleansCommonOcrSlips()
+	{
+		assertEquals("I don't know", SubtitleExtractor.cleanLine("| don't know |"))
+	}
+
+	@Test
+	fun rejectsNoise()
+	{
+		assertNull(SubtitleExtractor.extract(listOf(OcrLine("x", Box(600, 600, 610, 630))), w, h, true))
+		assertNull(SubtitleExtractor.extract(listOf(OcrLine("tiny text here", Box(500, 600, 700, 606))), w, h, true))
+	}
+}
