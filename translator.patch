+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// PS Arabic Translator — the live pipeline: grab frame → read text → translate → draw.
+
+package com.metallic.chiaki.translate
+
+import android.graphics.Bitmap
+import android.graphics.RectF
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.Looper
+import android.util.Log
+import android.util.LruCache
+import android.view.PixelCopy
+import android.view.SurfaceView
+import com.google.mlkit.common.model.DownloadConditions
+import com.google.mlkit.nl.translate.TranslateLanguage
+import com.google.mlkit.nl.translate.Translation
+import com.google.mlkit.nl.translate.Translator
+import com.google.mlkit.nl.translate.TranslatorOptions
+import com.google.mlkit.vision.common.InputImage
+import com.google.mlkit.vision.text.Text
+import com.google.mlkit.vision.text.TextRecognition
+import com.google.mlkit.vision.text.TextRecognizer
+import com.google.mlkit.vision.text.latin.TextRecognizerOptions
+import java.util.concurrent.Executor
+import kotlin.math.min
+
+/**
+ * Watches the Remote Play picture and lays an Arabic translation over the game's subtitles.
+ *
+ * Everything heavy runs on one background thread; the overlay is only touched on the main thread.
+ * Text recognition and translation both run on the device (Google ML Kit), so after the language
+ * model is downloaded once nothing is sent to any server and it works offline.
+ *
+ * Lifecycle: [start] in onResume, [stop] in onPause, [release] in onDestroy.
+ */
+class SubtitleTranslator(
+	private val surfaceView: SurfaceView,
+	private val overlay: SubtitleOverlayView
+)
+{
+	companion object
+	{
+		private const val TAG = "SubtitleTranslator"
+
+		/** Frames are scaled to this width before OCR: sharp enough for subtitles, cheap enough for a TV. */
+		private const val CAPTURE_WIDTH = 1280
+		/** Empty scans in a row before the Arabic box is removed (avoids flicker during fades). */
+		private const val MISSES_BEFORE_HIDE = 3
+		/** Two reads at least this similar count as the same, settled subtitle. */
+		private const val STABLE_SIMILARITY = 0.88
+		/** A read this close to what is already on screen is OCR jitter, not new dialogue. */
+		private const val SAME_SUBTITLE_SIMILARITY = 0.80
+		private const val MODEL_RETRY_MS = 15_000L
+
+		private const val MSG_PREPARING = "جاري تجهيز الترجمة… (أول مرة فقط: تحميل حوالي 30 ميجا)"
+		private const val MSG_READY = "الترجمة جاهزة ✓"
+		private const val MSG_MODEL_FAILED = "تعذّر تحميل نموذج الترجمة، تأكد من اتصال الإنترنت. سنعيد المحاولة تلقائياً"
+	}
+
+	@Volatile private var settings = TranslationSettings()
+	@Volatile private var running = false
+	@Volatile private var modelReady = false
+	/** Bumped on every start so callbacks from a previous run are ignored. */
+	@Volatile private var generation = 0
+
+	private val mainHandler = Handler(Looper.getMainLooper())
+	private var workerThread: HandlerThread? = null
+	private var worker: Handler? = null
+	private val workerExecutor = Executor { r -> worker?.post(r) }
+
+	private val recognizer: TextRecognizer = TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS)
+	private var translator: Translator? = null
+	private var translatorPair: Pair<String, String>? = null
+
+	// ---- state below is only touched on the worker thread ----
+	private var busy = false
+	private var captureBitmap: Bitmap? = null
+	private var candidateKey: String? = null
+	private var shownKey: String? = null
+	private var missCount = 0
+	private val cache = LruCache<String, String>(500)
+
+	private val scanRunnable = object : Runnable
+	{
+		override fun run()
+		{
+			if(!running)
+				return
+			worker?.postDelayed(this, settings.scanIntervalMs)
+			scan()
+		}
+	}
+
+	fun updateSettings(newSettings: TranslationSettings)
+	{
+		settings = newSettings
+		mainHandler.post { overlay.applySettings(newSettings) }
+	}
+
+	fun start()
+	{
+		if(running || !settings.enabled)
+			return
+		running = true
+		generation++
+		prepareTranslator()
+
+		val thread = HandlerThread("subtitle-translator").also { it.start() }
+		workerThread = thread
+		val handler = Handler(thread.looper)
+		worker = handler
+		handler.post {
+			busy = false
+			candidateKey = null
+			shownKey = null
+			missCount = 0
+		}
+		handler.postDelayed(scanRunnable, 1000)
+	}
+
+	fun stop()
+	{
+		running = false
+		worker?.removeCallbacksAndMessages(null)
+		workerThread?.quitSafely()
+		workerThread = null
+		worker = null
+		mainHandler.post { overlay.hideSubtitle() }
+	}
+
+	fun release()
+	{
+		stop()
+		mainHandler.removeCallbacksAndMessages(null)
+		recognizer.close()
+		translator?.close()
+		translator = null
+	}
+
+	// ---------------------------------------------------------------- translator model
+
+	private fun prepareTranslator()
+	{
+		val source = TranslateLanguage.fromLanguageTag(settings.sourceLanguage) ?: TranslateLanguage.ENGLISH
+		val target = TranslateLanguage.fromLanguageTag(settings.targetLanguage) ?: TranslateLanguage.ARABIC
+		val pair = source to target
+		if(translator != null && translatorPair == pair && modelReady)
+			return
+
+		if(translatorPair != pair)
+		{
+			translator?.close()
+			val options = TranslatorOptions.Builder()
+				.setSourceLanguage(source)
+				.setTargetLanguage(target)
+				.build()
+			translator = Translation.getClient(options)
+			translatorPair = pair
+			modelReady = false
+			cache.evictAll() // LruCache is thread-safe
+		}
+		downloadModel()
+	}
+
+	private fun downloadModel()
+	{
+		val t = translator ?: return
+		overlay.showStatus(MSG_PREPARING, sticky = true)
+		t.downloadModelIfNeeded(DownloadConditions.Builder().build())
+			.addOnSuccessListener {
+				if(t !== translator)
+					return@addOnSuccessListener
+				modelReady = true
+				overlay.showStatus(MSG_READY)
+			}
+			.addOnFailureListener { e ->
+				Log.w(TAG, "Translation model download failed", e)
+				if(t !== translator)
+					return@addOnFailureListener
+				overlay.showStatus(MSG_MODEL_FAILED)
+				mainHandler.postDelayed({ if(running && !modelReady) downloadModel() }, MODEL_RETRY_MS)
+			}
+	}
+
+	// ---------------------------------------------------------------- worker thread
+
+	private fun scan()
+	{
+		if(busy)
+			return
+		val handler = worker ?: return
+		val sw = surfaceView.width
+		val sh = surfaceView.height
+		val surface = surfaceView.holder.surface
+		if(sw <= 0 || sh <= 0 || surface == null || !surface.isValid)
+			return
+
+		val cw = min(CAPTURE_WIDTH, sw)
+		val ch = (cw.toLong() * sh / sw).toInt()
+		if(ch <= 0)
+			return
+		val bitmap = captureBitmap?.takeIf { it.width == cw && it.height == ch && !it.isRecycled }
+			?: Bitmap.createBitmap(cw, ch, Bitmap.Config.ARGB_8888).also { captureBitmap = it }
+
+		busy = true
+		val gen = generation
+		try
+		{
+			PixelCopy.request(surfaceView, bitmap, { result -> onFrameCopied(result, bitmap, gen) }, handler)
+		}
+		catch(e: IllegalArgumentException)
+		{
+			// Surface went away between the check and the copy (e.g. app paused).
+			busy = false
+		}
+	}
+
+	private fun onFrameCopied(result: Int, frame: Bitmap, gen: Int)
+	{
+		if(gen != generation)
+			return
+		if(!running || result != PixelCopy.SUCCESS)
+		{
+			busy = false
+			return
+		}
+		val top = (frame.height * settings.scanRegion.topFraction).toInt().coerceIn(0, frame.height - 1)
+		val region = if(top == 0) frame else Bitmap.createBitmap(frame, 0, top, frame.width, frame.height - top)
+		val frameWidth = frame.width
+		val frameHeight = frame.height
+
+		recognizer.process(InputImage.fromBitmap(region, 0))
+			.addOnSuccessListener(workerExecutor) { text ->
+				if(gen != generation)
+					return@addOnSuccessListener
+				try
+				{
+					onTextRead(text, top, frameWidth, frameHeight)
+				}
+				finally
+				{
+					busy = false
+				}
+			}
+			.addOnFailureListener(workerExecutor) { e ->
+				Log.w(TAG, "Text recognition failed", e)
+				if(gen == generation)
+					busy = false
+			}
+	}
+
+	private fun onTextRead(text: Text, regionTop: Int, frameWidth: Int, frameHeight: Int)
+	{
+		val lines = text.textBlocks.flatMap { it.lines }.mapNotNull { line ->
+			val r = line.boundingBox ?: return@mapNotNull null
+			OcrLine(line.text, Box(r.left, r.top + regionTop, r.right, r.bottom + regionTop))
+		}
+		val block = SubtitleExtractor.extract(lines, frameWidth, frameHeight, settings.centeredOnly)
+
+		if(block == null)
+		{
+			candidateKey = null
+			missCount++
+			if(missCount >= MISSES_BEFORE_HIDE && shownKey != null)
+			{
+				shownKey = null
+				mainHandler.post { overlay.hideSubtitle() }
+			}
+			return
+		}
+		missCount = 0
+
+		val shown = shownKey
+		if(shown != null && SubtitleExtractor.similarity(block.key, shown) >= SAME_SUBTITLE_SIMILARITY)
+			return
+
+		// Wait for the same text on two reads in a row: skips half-faded frames and
+		// typewriter-style subtitles that are still being written out.
+		val candidate = candidateKey
+		candidateKey = block.key
+		if(candidate == null || SubtitleExtractor.similarity(block.key, candidate) < STABLE_SIMILARITY)
+			return
+
+		shownKey = block.key
+		val cached = cache.get(block.key)
+		if(cached != null)
+		{
+			display(cached, block.box, frameWidth)
+			return
+		}
+		translate(block, frameWidth)
+	}
+
+	private fun translate(block: SubtitleBlock, frameWidth: Int)
+	{
+		val t = translator
+		if(t == null || !modelReady)
+		{
+			shownKey = null // try again once the model is ready
+			return
+		}
+		t.translate(block.text)
+			.addOnSuccessListener(workerExecutor) { arabic ->
+				val clean = arabic.trim()
+				if(clean.isEmpty())
+					return@addOnSuccessListener
+				cache.put(block.key, clean)
+				if(shownKey == block.key)
+					display(clean, block.box, frameWidth)
+			}
+			.addOnFailureListener(workerExecutor) { e ->
+				Log.w(TAG, "Translation failed", e)
+				if(shownKey == block.key)
+					shownKey = null
+			}
+	}
+
+	// ---------------------------------------------------------------- main thread
+
+	private fun display(arabic: String, box: Box, frameWidth: Int)
+	{
+		mainHandler.post {
+			if(!running)
+				return@post
+			overlay.showSubtitle(arabic, mapToOverlay(box, frameWidth))
+		}
+	}
+
+	/** Frame pixels → overlay coordinates, following the stream view's position and zoom mode. */
+	private fun mapToOverlay(box: Box, frameWidth: Int): RectF?
+	{
+		if(surfaceView.width <= 0 || frameWidth <= 0)
+			return null
+		val scale = surfaceView.width.toFloat() / frameWidth
+		val sv = IntArray(2)
+		val ov = IntArray(2)
+		surfaceView.getLocationInWindow(sv)
+		overlay.getLocationInWindow(ov)
+		val dx = (sv[0] - ov[0]).toFloat()
+		val dy = (sv[1] - ov[1]).toFloat()
+		return RectF(
+			box.left * scale + dx,
+			box.top * scale + dy,
+			box.right * scale + dx,
+			box.bottom * scale + dy)
+	}
+}
diff --git a/android/app/src/main/java/com/metallic/chiaki/translate/TranslationSettings.kt b/android/app/src/main/java/com/metallic/chiaki/translate/TranslationSettings.kt
new file mode 100644
index 00000000..03e7a788
--- /dev/null
+++ b/android/app/src/main/java/com/metallic/chiaki/translate/TranslationSettings.kt
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// PS Arabic Translator — on-screen subtitle translation for Remote Play.
+
+package com.metallic.chiaki.translate
+
+/**
+ * User-facing options for the live subtitle translator.
+ * Kept free of Android preference classes so it can be built and tested on its own.
+ */
+data class TranslationSettings(
+	val enabled: Boolean = true,
+	/** ML Kit language tag of the game's subtitles, e.g. "en". */
+	val sourceLanguage: String = "en",
+	/** ML Kit language tag to translate into. */
+	val targetLanguage: String = "ar",
+	val scanRegion: ScanRegion = ScanRegion.BOTTOM_THIRD,
+	val placement: Placement = Placement.COVER_ORIGINAL,
+	val textSize: TextSize = TextSize.MEDIUM,
+	/** Ignore text near the left/right edges (HUD, menus) and keep centred subtitles only. */
+	val centeredOnly: Boolean = true,
+	/** How often a frame is read, in milliseconds. */
+	val scanIntervalMs: Long = 300L
+)
+{
+	enum class ScanRegion(val value: String, val topFraction: Float)
+	{
+		BOTTOM_THIRD("bottom_third", 0.62f),
+		BOTTOM_HALF("bottom_half", 0.45f),
+		FULL_SCREEN("full", 0.0f);
+
+		companion object
+		{
+			fun from(value: String?) = values().firstOrNull { it.value == value } ?: BOTTOM_THIRD
+		}
+	}
+
+	enum class Placement(val value: String)
+	{
+		/** Draw the Arabic box right on top of the original subtitle. */
+		COVER_ORIGINAL("cover"),
+		/** Always show the translation in a fixed band at the bottom of the screen. */
+		BOTTOM_BAND("bottom");
+
+		companion object
+		{
+			fun from(value: String?) = values().firstOrNull { it.value == value } ?: COVER_ORIGINAL
+		}
+	}
+
+	enum class TextSize(val value: String, val sp: Float)
+	{
+		SMALL("small", 18f),
+		MEDIUM("medium", 24f),
+		LARGE("large", 30f),
+		XLARGE("xlarge", 36f);
+
+		companion object
+		{
+			fun from(value: String?) = values().firstOrNull { it.value == value } ?: MEDIUM
+		}
+	}
+}
