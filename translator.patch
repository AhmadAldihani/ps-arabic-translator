@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// PS Arabic Translator — picks the subtitle out of everything OCR finds on screen.
+
+package com.metallic.chiaki.translate
+
+import kotlin.math.abs
+import kotlin.math.max
+import kotlin.math.min
+
+/** Integer rectangle in frame pixels (Android-free so the logic can be unit tested on the JVM). */
+data class Box(val left: Int, val top: Int, val right: Int, val bottom: Int)
+{
+	val width get() = right - left
+	val height get() = bottom - top
+	val centerX get() = (left + right) / 2f
+
+	fun union(o: Box) = Box(min(left, o.left), min(top, o.top), max(right, o.right), max(bottom, o.bottom))
+	fun offset(dx: Int, dy: Int) = Box(left + dx, top + dy, right + dx, bottom + dy)
+}
+
+data class OcrLine(val text: String, val box: Box)
+
+/**
+ * A subtitle found on one frame.
+ * [text] is what gets translated, [key] is a normalised form used to tell
+ * "same subtitle, OCR jitter" apart from "a new line of dialogue".
+ */
+data class SubtitleBlock(val text: String, val key: String, val box: Box, val lineHeight: Int)
+
+object SubtitleExtractor
+{
+	private val letterRegex = Regex("\\p{L}")
+	private val digitRegex = Regex("\\p{N}")
+	private val junkEdges = Regex("^[\\s|_~•·*#=<>\\[\\]{}]+|[\\s|_~•·*#=<>\\[\\]{}]+$")
+	private val multiSpace = Regex("\\s+")
+	private val keyStrip = Regex("[^\\p{L}\\p{N} ]")
+	private val leadingPipe = Regex("^\\|(?=\\s+\\p{L})")
+	private val innerPipe = Regex("(?<=\\s)\\|(?=\\s+\\p{L})")
+
+	/** Minimum height of a text line, as a fraction of the frame height. Smaller text is HUD noise. */
+	private const val MIN_LINE_HEIGHT_FRACTION = 0.012f
+	/** Centred-only mode keeps lines whose centre lies in this middle band of the frame. */
+	private const val CENTER_BAND_MIN = 0.25f
+	private const val CENTER_BAND_MAX = 0.75f
+
+	fun cleanLine(raw: String): String
+	{
+		var s = raw.replace(' ', ' ').trim()
+		// The most common OCR slip in game fonts: a lone pipe read instead of the pronoun "I".
+		// Only at the start or between words; a pipe at the very end is a border, stripped below.
+		s = s.replace(leadingPipe, "I").replace(innerPipe, "I")
+		s = s.replace(junkEdges, "")
+		return s.replace(multiSpace, " ").trim()
+	}
+
+	fun isUsefulLine(text: String, box: Box, frameWidth: Int, frameHeight: Int, centeredOnly: Boolean): Boolean
+	{
+		val letters = letterRegex.findAll(text).count()
+		if(letters < 2)
+			return false
+		// Timers, scores, ammo counters…
+		val digits = digitRegex.findAll(text).count()
+		if(digits > letters)
+			return false
+		if(frameHeight > 0 && box.height < frameHeight * MIN_LINE_HEIGHT_FRACTION)
+			return false
+		if(centeredOnly && frameWidth > 0)
+		{
+			val c = box.centerX / frameWidth
+			if(c < CENTER_BAND_MIN || c > CENTER_BAND_MAX)
+				return false
+		}
+		return true
+	}
+
+	/**
+	 * Groups the OCR lines into paragraphs and returns the one that most looks like a subtitle:
+	 * the paragraph with the most letters, preferring the lower one on a tie.
+	 */
+	fun extract(rawLines: List<OcrLine>, frameWidth: Int, frameHeight: Int, centeredOnly: Boolean): SubtitleBlock?
+	{
+		val lines = rawLines
+			.map { OcrLine(cleanLine(it.text), it.box) }
+			.filter { isUsefulLine(it.text, it.box, frameWidth, frameHeight, centeredOnly) }
+			.sortedBy { it.box.top }
+		if(lines.isEmpty())
+			return null
+
+		val groups = mutableListOf<MutableList<OcrLine>>()
+		for(line in lines)
+		{
+			val group = groups.lastOrNull()
+			if(group != null && belongsTo(group, line, frameWidth))
+				group.add(line)
+			else
+				groups.add(mutableListOf(line))
+		}
+
+		val best = groups.maxWithOrNull(
+			compareBy<List<OcrLine>> { g -> g.sumOf { letterRegex.findAll(it.text).count() } }
+				.thenBy { g -> g.last().box.bottom }
+		) ?: return null
+
+		val text = joinForTranslation(best.map { it.text })
+		val key = normalize(text)
+		if(key.isEmpty())
+			return null
+		val box = best.map { it.box }.reduce { a, b -> a.union(b) }
+		val lineHeight = best.map { it.box.height }.average().toInt()
+		return SubtitleBlock(text, key, box, lineHeight)
+	}
+
+	private fun belongsTo(group: List<OcrLine>, line: OcrLine, frameWidth: Int): Boolean
+	{
+		val prev = group.last()
+		val gap = line.box.top - prev.box.bottom
+		val lineH = max(prev.box.height, line.box.height)
+		if(gap > lineH * 1.3f)
+			return false
+		val groupCenter = group.map { it.box.centerX }.average().toFloat()
+		return abs(line.box.centerX - groupCenter) < frameWidth * 0.25f
+	}
+
+	/**
+	 * Subtitles wrap long sentences over several lines; the translator works much better on the
+	 * whole sentence. Lines that start with a dash are separate speakers and keep their own line.
+	 */
+	fun joinForTranslation(lines: List<String>): String
+	{
+		val sb = StringBuilder()
+		for(line in lines)
+		{
+			if(sb.isEmpty())
+			{
+				sb.append(line)
+				continue
+			}
+			val newSpeaker = line.startsWith("-") || line.startsWith("–") || line.startsWith("—")
+			when
+			{
+				newSpeaker -> sb.append('\n').append(line)
+				sb.endsWith("-") && !sb.endsWith(" -") -> { sb.setLength(sb.length - 1); sb.append(line) }
+				else -> sb.append(' ').append(line)
+			}
+		}
+		return sb.toString()
+	}
+
+	fun normalize(text: String): String =
+		text.lowercase().replace(keyStrip, " ").replace(multiSpace, " ").trim()
+
+	/** 1.0 = identical, 0.0 = nothing in common (normalised Levenshtein). */
+	fun similarity(a: String, b: String): Double
+	{
+		if(a == b)
+			return 1.0
+		if(a.isEmpty() || b.isEmpty())
+			return 0.0
+		val prev = IntArray(b.length + 1) { it }
+		val cur = IntArray(b.length + 1)
+		for(i in 1..a.length)
+		{
+			cur[0] = i
+			for(j in 1..b.length)
+			{
+				val cost = if(a[i - 1] == b[j - 1]) 0 else 1
+				cur[j] = min(min(cur[j - 1] + 1, prev[j] + 1), prev[j - 1] + cost)
+			}
+			System.arraycopy(cur, 0, prev, 0, cur.size)
+		}
+		return 1.0 - prev[b.length].toDouble() / max(a.length, b.length)
+	}
+}
